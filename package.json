{
  "name": "@jwhenry123/mesh",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk/*": "./src/sdk/*"
  },
  "files": [
    "dist",
    "src/sdk",
    "!src/sdk/**/*.test.ts",
    "!dist/**/*.map"
  ],
  "sideEffects": [
    "**/workerBootstrap.ts",
    "**/workerBootstrap.js"
  ],
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "kill:all": "node scripts/kill-all.mjs",
    "serve:all": "node scripts/serve-all.mjs",
    "serve:docs": "node scripts/serve-docs.mjs",
    "build": "tsc --noEmit && vite build && vite build --config vite.app.config.ts",
    "test": "vitest run",
    "build:pages": "node scripts/build-pages.mjs",
    "assemble:pages": "node scripts/assemble-pages.mjs"
  },
  "devDependencies": {
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-json-stringify": "^7.0.1",
    "happy-dom": "^20.14.5",
    "htmlparser2": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-reconciler": "^0.34.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "vue": "^3.5.43"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "msgpackr": "^2.1.0",
    "solid-js": "^1.9.15",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jwhenry3/mesh"
  }
}
